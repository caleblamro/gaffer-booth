# Copy to .env (gitignored) and fill in one block. Real environment variables win over .env.
# With nothing set, the crew runs on its verified template tier.

# OpenRouter (free models end in ":free"; pick one at https://openrouter.ai/models)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# GitHub Models (free, rate-limited; token needs the "Models" permission)
# OPENAI_BASE_URL=https://models.github.ai/inference
# OPENAI_API_KEY=
# OPENAI_MODEL=openai/gpt-4.1-mini

# Microsoft Foundry project
# FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_MODEL=gpt-4.1-mini

# Set to "prompt" for models that reject structured output (detected automatically otherwise).
# BOOTH_JSON_MODE=prompt
# Seconds before a slow model call falls back to the template tier.
# BOOTH_LLM_TIMEOUT=8
